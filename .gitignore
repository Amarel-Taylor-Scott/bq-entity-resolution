# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
*.egg
.eggs/
build/
dist/
sdist/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Secrets / credentials (never commit)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
service-account*.json
sa-*.json

# Local databases / data dumps
*.db
*.sqlite
*.sqlite3
*.duckdb

# Editor / OS noise
.DS_Store
.idea/
.vscode/
.claude/

# Local config-driven JSON (allow checked-in config JSON)
*.json
!config/**/*.json
!.github/**/*.json
!**/*.example.json
